DATABASE_URL=postgresql://{YOUR_PATH}
PORT=3000
RABBITMQ_URL=amqp://guest:guest@localhost:5672
THROTTLE_LIMIT=10
THROTTLE_TTL_MS=60000
RIDER_REVIEW_AFTER_MIN=10
RIDER_REVIEW_INTERVAL_MS=60000
RIDER_REVIEW_ENABLED=true
KITCHEN_RECONCILE_INTERVAL_MS=30000
KITCHEN_RECONCILE_ENABLED=true
NODE_ENV=development
{
  "info": {
    "name": "Orders Service",
    "description": "Place, list (paginated), track, cancel — Port 3002. All routes need a Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002"
    },
    {
      "key": "token",
      "value": "",
      "description": "Paste a customer JWT here (login via auth-service as customer@swiftbite.local)"
    },
    {
      "key": "itemId",
      "value": "",
      "description": "Copy from GET /items on item-service (:3001)"
    },
    {
      "key": "orderId",
      "value": "",
      "description": "Auto-saved by POST /orders test script"
    }
  ],
  "item": [
    {
      "name": "POST /orders (multi-line)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.orderId) { pm.collectionVariables.set('orderId', res.orderId); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Demo User\",\n  \"street\": \"123 Main St\",\n  \"area\": \"Downtown\",\n  \"lines\": [\n    { \"menuItemId\": \"{{itemId}}\", \"quantity\": 2 }\n  ]\n}"
        }
      }
    },
    {
      "name": "POST /orders (no token → 401)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Nobody\",\n  \"street\": \"123 Main St\",\n  \"area\": \"Downtown\",\n  \"lines\": [\n    { \"menuItemId\": \"{{itemId}}\", \"quantity\": 1 }\n  ]\n}"
        }
      }
    },
    {
      "name": "GET /orders?page=1&limit=10",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/orders?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["orders"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "GET /orders?status=pending",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/orders?status=pending",
          "host": ["{{baseUrl}}"],
          "path": ["orders"],
          "query": [
            { "key": "status", "value": "pending" }
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "GET /orders/:id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": ["{{baseUrl}}"],
          "path": ["orders", "{{orderId}}"]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "PATCH /orders/:id/cancel",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["orders", "{{orderId}}", "cancel"]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    }
  ]
}
